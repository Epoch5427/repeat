    </screenshot>
    <screenshot type="default">
      <image>https://github.com/user-attachments/assets/98f0fae3-6ff7-4904-8ecd-8b066c96606e</image>
      <caption>The main keyboard settings and timing configuration panel.</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.0" date="2026-06-03">
      <url type="details">https://example.org/changelog.html#version_1.0.0</url>
      <description translate="no">
        <p>Initial Release</p>
      </description>
    </release>
  </releases>

</component>
